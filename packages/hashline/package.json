{
	"type": "module",
	"name": "@evopi/hashline",
	"version": "0.9.7",
	"description": "Hashline: a compact, line-anchored patch language and applier. Node-only backport wired to @evopi/pi-natives-loader.",
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx cp src/grammar.lark src/prompt.md dist/",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest --run"
	},
	"dependencies": {
		"@evopi/pi-natives-loader": "^0.9.7"
	},
	"keywords": [
		"patch",
		"diff",
		"edit",
		"hashline",
		"agent",
		"llm"
	],
	"engines": {
		"node": ">=20.0.0"
	},
	"files": [
		"dist",
		"README.md"
	],
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
