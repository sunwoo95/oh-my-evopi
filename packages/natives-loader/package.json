{
	"name": "@evopi/pi-natives-loader",
	"version": "0.9.7",
	"description": "Node-only loader for prebuilt pi-natives: direct leaf .node require, AVX2 variant selection, null fallback",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest --run"
	},
	"optionalDependencies": {
		"@oh-my-pi/pi-natives": "18.1.2"
	},
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
